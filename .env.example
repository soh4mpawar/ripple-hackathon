# Ripple Environment Configuration

# Appwrite Connection
NEXT_PUBLIC_APPWRITE_ENDPOINT="https://cloud.appwrite.io/v1"
NEXT_PUBLIC_APPWRITE_PROJECT_ID="ripple-project-id"
APPWRITE_API_KEY="your-appwrite-server-api-key"
APPWRITE_DATABASE_ID="ripple_db"
APPWRITE_STORAGE_BUCKET_ID="ripple_materials"

# AI Multimodal Extraction Provider (OpenAI or any OpenAI-compatible multimodal endpoint)
AI_PROVIDER="openai"
AI_API_KEY="your-ai-api-key"
AI_MODEL="gpt-4o-mini"
# Optional custom base URL (e.g., https://api.openai.com/v1 or local / proxy gateway)
AI_BASE_URL=""

# Session Cookie Name (default: ripple_session)
SESSION_COOKIE_NAME="ripple_session"
