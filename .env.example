# Ripple Environment Configuration

# Appwrite Connection (Appwrite Cloud Singapore or Default Cloud)
NEXT_PUBLIC_APPWRITE_ENDPOINT="https://sgp.cloud.appwrite.io/v1"
NEXT_PUBLIC_APPWRITE_PROJECT_ID="your-project-id"
APPWRITE_API_KEY="your-appwrite-server-api-key"
APPWRITE_DATABASE_ID="ripple_db"
APPWRITE_STORAGE_BUCKET_ID="ripple_materials"

# AI Multimodal Extraction (OpenAI-compatible Chat Completions API)
# Optional: If omitted, Ripple automatically uses its deterministic rule-based text parser,
# and image uploads default to manual claim review with zero interruption.
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"
AI_BASE_URL="https://api.openai.com/v1"

# Session Cookie Name (default: ripple_session)
SESSION_COOKIE_NAME="ripple_session"
